# Deny by default: ~/.claude links to this repo, so only the files listed below are published;
# everything else, new files included, stays out.
*
!.gitignore
!CLAUDE.md
!LICENSE
!README.md
!settings.json
!agents/
!agents/*.md
!hooks/
!hooks/*.sh
!rules/
!rules/*.md
!.claude/
!.claude/CLAUDE.md
!.claude-plugin/
!.claude-plugin/marketplace.json
!mods/
!mods/statusband/
!mods/statusband/tsconfig.json
!mods/statusband/.claude-plugin/
!mods/statusband/.claude-plugin/plugin.json
!mods/statusband/hooks/
!mods/statusband/hooks/*
!mods/statusband/types/
!mods/statusband/types/*.d.ts
!mods/statusband/tests/
!mods/statusband/tests/*.test.ts
